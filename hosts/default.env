# Generic defaults. Server-specific profiles live OUTSIDE this public repo, in
# ~/.config/vps/hosts/<name>.env (and ~/.config/vps/local.env).

# Modules run by `vps apply`, in this order.
MODULES="base dotfiles ssh-client ssh-harden firewall fail2ban auto-updates sysctl shell git bun claude codex docker hermes"

# Login user created by bootstrap.sh when it runs as root on a fresh VPS.
VPS_USER=${VPS_USER:-$USER}

TIMEZONE=Europe/Warsaw
SWAP_MB=0                    # >0: create a swap file of this size when the box has no swap

# Public keys appended to ~/.ssh/authorized_keys (never removed). Empty = skip.
AUTHORIZED_KEYS_URL=https://github.com/teziovsky.keys

# ssh-harden: key-only login, no root. Refuses to run unless the login user already has a key.
SSH_ALLOW_USERS=$VPS_USER
SSH_PERMIT_ROOT=no

# firewall (ufw): SSH's own port is always allowed and rate-limited.
FIREWALL_ALLOW_TCP="80 443"
FIREWALL_ALLOW_UDP=""

# auto-updates: security updates install by themselves; reboot only if you say so.
AUTO_REBOOT=false
AUTO_REBOOT_TIME=04:30

# apps: a repo with an `apps` CLI to clone (private profile sets it; empty = module does nothing).
APPS_REPO=
APPS_DIR=$HOME/apps

# docker: weekly prune of unused images/build cache (volumes are never pruned).
DOCKER_PRUNE=true

# audit: warn when the newest file under BACKUP_PATH is older than BACKUP_MAX_AGE_HOURS.
# Empty BACKUP_PATH = no backup check. Point it at wherever your backup job writes.
BACKUP_PATH=
BACKUP_MAX_AGE_HOURS=26
