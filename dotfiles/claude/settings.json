{
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "permissions": {
    "allow": [
      "Read(**/.env.example)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.dev)",
      "Read(**/.env.development)",
      "Read(**/.env.demo)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Read(**/.env.prod)",
      "Read(**/.env.production)",
      "Read(**/.env.*.local)",
      "Read(**/.env.backup)",
      "Read(**/.env.bak)",
      "Read(**/.envrc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/secrets/**)",
      "Read(**/credentials*)"
    ]
  },
  "model": "sonnet",
  "enableWorkflows": true,
  "enabledPlugins": {
    "telemetry@builtin": false,
    "context7@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "opus",
  "tui": "default",
  "preferredNotifChannel": "auto",
  "inputNeededNotifEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-starship.sh"
  }
}
