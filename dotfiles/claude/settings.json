{
  "permissions": {
    "allow": [
      "Read(**/.env.example)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.dev)",
      "Read(**/.env.development)",
      "Read(**/.env.demo)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Read(**/.env.prod)",
      "Read(**/.env.production)",
      "Read(**/.env.*.local)",
      "Read(**/.env.backup)",
      "Read(**/.env.bak)",
      "Read(**/.envrc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/secrets/**)",
      "Read(**/credentials*)",
      "Read(/etc/shadow)",
      "Read(/etc/ssh/ssh_host_*)",
      "Read(~/.config/vps/local.env)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(mkfs*)",
      "Bash(dd if=*of=/dev/*)",
      "Bash(*ufw disable*)",
      "Bash(*ufw reset*)",
      "Bash(*docker system prune*--volumes*)",
      "Bash(*docker volume prune*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ],
    "ask": [
      "Bash(sudo systemctl stop*)",
      "Bash(sudo systemctl restart ssh*)",
      "Bash(sudo systemctl disable*)",
      "Bash(sudo ufw*)",
      "Bash(sudo reboot*)",
      "Bash(sudo shutdown*)",
      "Bash(reboot*)",
      "Bash(shutdown*)",
      "Bash(docker rm*)",
      "Bash(docker volume rm*)",
      "Bash(docker compose down*)",
      "Bash(docker stop*)",
      "Bash(sudo apt*remove*)",
      "Bash(sudo apt*purge*)",
      "Bash(sudo rm *)",
      "Bash(sudo vim /etc/ssh/*)"
    ]
  },
  "model": "sonnet",
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-starship.sh"
  },
  "enabledPlugins": {
    "telemetry@builtin": false,
    "context7@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "opus",
  "tui": "default",
  "theme": "dark",
  "preferredNotifChannel": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
